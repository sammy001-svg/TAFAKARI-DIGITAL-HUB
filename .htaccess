Options -MultiViews
RewriteEngine On
RewriteBase /

# Custom error pages
ErrorDocument 404 /404.php

# Let real files and directories pass through
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── API routes ──────────────────────────────────────────────────
RewriteRule ^api/posts/([^/]+)/approve/?$  api/post-approve.php?id=$1  [L,QSA]
RewriteRule ^api/posts/([^/]+)/publish/?$  api/post-publish.php?id=$1  [L,QSA]
RewriteRule ^api/posts/([^/]+)/submit/?$   api/post-submit.php?id=$1   [L,QSA]
RewriteRule ^api/posts/([^/]+)/archive/?$  api/post-archive.php?id=$1  [L,QSA]
RewriteRule ^api/posts/([^/]+)/?$         api/post.php?id=$1         [L,QSA]
RewriteRule ^api/posts/?$                 api/posts.php              [L,QSA]
RewriteRule ^api/comments/([^/]+)/?$      api/comment.php?id=$1      [L,QSA]
RewriteRule ^api/comments/?$              api/comments.php           [L,QSA]
RewriteRule ^api/contact/([^/]+)/?$       api/contact-message.php?id=$1 [L,QSA]
RewriteRule ^api/contact/?$               api/contact.php            [L,QSA]
RewriteRule ^api/users/([^/]+)/?$         api/user.php?id=$1         [L,QSA]
RewriteRule ^api/users/?$                 api/users.php              [L,QSA]
RewriteRule ^api/stats/?$                 api/stats.php              [L,QSA]
RewriteRule ^api/setup/init-db/?$         api/setup-init.php         [L,QSA]
RewriteRule ^api/setup/?$                 api/setup-check.php        [L,QSA]
RewriteRule ^api/upload/?$                api/upload.php             [L,QSA]
RewriteRule ^api/settings/?$             api/settings.php           [L,QSA]

# ── SEO / system ─────────────────────────────────────────────────
RewriteRule ^sitemap\.xml$                sitemap.php          [L]

# ── Public pages ─────────────────────────────────────────────────
RewriteRule ^about/?$                     about.php            [L]
RewriteRule ^search/?$                    search.php           [L]
RewriteRule ^contact/?$                   contact.php          [L]
RewriteRule ^news/([^/]+)/?$              news-detail.php?id=$1 [L,QSA]
RewriteRule ^news/?$                      news.php             [L]
RewriteRule ^documents/([^/]+)/?$         document-detail.php?id=$1 [L,QSA]
RewriteRule ^documents/?$                 documents.php        [L]
RewriteRule ^gallery/?$                   gallery.php          [L]
RewriteRule ^heatmap/?$                   heatmap.php          [L]
RewriteRule ^podcasts/([^/]+)/?$          podcast-detail.php?id=$1  [L,QSA]
RewriteRule ^podcasts/?$                  podcasts.php         [L]
RewriteRule ^videos/([^/]+)/?$            video-detail.php?id=$1    [L,QSA]
RewriteRule ^videos/?$                    videos.php           [L]
RewriteRule ^setup/?$                     setup.php            [L]
RewriteRule ^login/?$                     login.php            [L]
RewriteRule ^reset-admin/?$               reset-admin.php      [L]

# ── PWA routes ───────────────────────────────────────────────────
RewriteRule ^offline/?$                   offline.php          [L]

<Files "sw.js">
  Header set Service-Worker-Allowed "/"
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>

<Files "manifest.json">
  Header set Content-Type "application/manifest+json; charset=utf-8"
  Header set Cache-Control "public, max-age=86400"
</Files>

# ── Admin routes ─────────────────────────────────────────────────
RewriteRule ^admin/?$                     admin/dashboard.php          [L]
RewriteRule ^admin/login/?$               admin/login.php              [L]
RewriteRule ^admin/logout/?$              admin/logout.php             [L]
RewriteRule ^admin/dashboard/?$           admin/dashboard.php          [L]
RewriteRule ^admin/profile/?$             admin/profile.php            [L]
RewriteRule ^admin/content/?$                     admin/content/index.php      [L,QSA]
RewriteRule ^admin/content/new/?$                 admin/content/new.php        [L,QSA]
RewriteRule ^admin/content/articles/?$            admin/content/articles.php   [L,QSA]
RewriteRule ^admin/content/gallery/?$             admin/content/gallery.php    [L,QSA]
RewriteRule ^admin/content/podcasts/?$            admin/content/podcasts.php   [L,QSA]
RewriteRule ^admin/content/videos/?$              admin/content/videos.php     [L,QSA]
RewriteRule ^admin/content/documents/?$           admin/content/documents.php  [L,QSA]
RewriteRule ^admin/content/([^/]+)/edit/?$        admin/content/edit.php?id=$1 [L,QSA]
RewriteRule ^admin/super/approvals/?$     admin/super/approvals.php    [L]
RewriteRule ^admin/super/moderation/?$    admin/super/moderation.php   [L]
RewriteRule ^admin/super/users/?$         admin/super/users.php        [L]
RewriteRule ^admin/super/messages/?$      admin/super/messages.php     [L]
RewriteRule ^admin/super/settings/?$      admin/super/settings.php     [L,QSA]
RewriteRule ^admin/super/heatmap/?$       admin/super/heatmap.php      [L,QSA]
