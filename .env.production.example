# =============================================================
# Tafakari Digital Hub — PRODUCTION Environment Variables
# =============================================================
# 1. Copy this file:   cp .env.production.example .env.production
# 2. Fill in every value below.
# 3. On cPanel, set these as environment variables in the
#    Node.js App Manager panel instead of using a file.
# =============================================================

# ── MySQL Database (cPanel) ────────────────────────────────────
# Find your values in cPanel → MySQL Databases
# Format: mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
# Note: DB_USER and DB_NAME are usually prefixed with your cPanel username
#   e.g.  cpanelusername_tafakari  /  cpanelusername_dbuser
DATABASE_URL="mysql://cpanelusername_dbuser:YourStrongDBPassword@localhost:3306/cpanelusername_tafakari"

# ── NextAuth ───────────────────────────────────────────────────
# Must be your live domain — NO trailing slash
# Must match the domain in your cPanel Node.js app URL
NEXTAUTH_URL="https://yourdomain.com"

# Random 32-byte secret — generate one with:
#   openssl rand -base64 32
# NEVER reuse the development secret in production.
NEXTAUTH_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_FROM_OPENSSL"

# ── Node environment ───────────────────────────────────────────
NODE_ENV="production"

# ── Port (optional) ───────────────────────────────────────────
# cPanel Node.js App Manager sets PORT automatically.
# Uncomment only if you need to override it.
# PORT=3000
