# =============================================================
# Tafakari Digital Hub — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# ── Database (MySQL) ───────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# XAMPP (local development):
DATABASE_URL="mysql://root:@localhost:3306/tafakari_hub"
#
# cPanel hosting (replace placeholders):
# DATABASE_URL="mysql://cpanelusername_dbuser:YourDBPassword@localhost:3306/cpanelusername_tafakari"

# ── NextAuth ───────────────────────────────────────────────────
# The full public URL of your site (no trailing slash)
# Local:
NEXTAUTH_URL="http://localhost:3000"
# cPanel:
# NEXTAUTH_URL="https://yourdomain.com"

# Random secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET_STRING"

# ── Node Environment ───────────────────────────────────────────
NODE_ENV="production"
