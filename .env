# ── Database (MySQL / XAMPP) ───────────────────────────────────
# XAMPP default: root user with no password
DATABASE_URL="mysql://root:@localhost:3306/tafakari_hub"

# ── cPanel hosting — uncomment and fill in your values:
# DATABASE_URL="mysql://cpanel_dbuser:YourDBPassword@localhost:3306/cpanel_dbname"

# ── NextAuth ───────────────────────────────────────────────────
NEXTAUTH_SECRET="f3c8a9d0b1e2f3g4h5i6j7k8l9m0n1o2p3q4r5s6"
NEXTAUTH_URL="http://localhost:3000"

# ── Production — uncomment on cPanel:
# NEXTAUTH_URL="https://yourdomain.com"
# NODE_ENV="production"
