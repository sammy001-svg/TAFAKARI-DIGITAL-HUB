generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum ContentStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ContentType {
  ARTICLE
  GALLERY_IMAGE
  PODCAST
  VIDEO
  DOCUMENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  username      String?   @unique
  password      String
  role          Role      @default(ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  posts         Post[]    @relation("UserPosts")
  approvedPosts Post[]    @relation("ApprovedBy")
}

model Post {
  id             String        @id @default(cuid())
  title          String
  content        String?       @db.Text
  description    String?       @db.Text
  thumbnailUrl   String?
  mediaUrl       String?
  type           ContentType   @default(ARTICLE)
  status         ContentStatus @default(DRAFT)
  authorId       String
  author         User          @relation("UserPosts", fields: [authorId], references: [id])
  approverId     String?
  approver       User?         @relation("ApprovedBy", fields: [approverId], references: [id])
  rejectionNotes String?       @db.Text

  // Regional Tagging
  country        String
  region         String
  issueCategory  String

  // Analytics
  viewCount      Int           @default(0)
  downloadCount  Int           @default(0)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  comments       Comment[]

  @@index([authorId])
  @@index([approverId])
  @@index([status])
  @@index([country])
}

model Comment {
  id          String   @id @default(cuid())
  content     String   @db.Text
  rating      Int?
  name        String?
  email       String?
  isModerated Boolean  @default(false)
  isFlagged   Boolean  @default(false)
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([postId])
  @@index([isFlagged])
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  country   String
  interest  String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
}

model HeatmapCountry {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  centerLat Float
  centerLng Float
  zoom      Int      @default(6)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model HeatmapCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}
